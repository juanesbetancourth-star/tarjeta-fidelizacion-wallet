# ============================================================
# VARIABLES DE ENTORNO FRONTEND (Vite)
# ============================================================
# En desarrollo local puedes dejarlo vacío (se conecta a :3001 automáticamente).
# En producción, especifica la URL pública completa de tu API backend:
# VITE_BACKEND_URL=https://api.tudominio.com
# O si usas un reverse proxy Nginx con /api en el mismo dominio, déjalo vacío o usa:
# VITE_BACKEND_URL=https://tudominio.com
VITE_BACKEND_URL=
