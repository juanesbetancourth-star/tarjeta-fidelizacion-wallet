# Dependencias
node_modules/
server/node_modules/

# Builds de producción
dist/
build/

# Archivos de entorno y credenciales sensibles (NUNCA SUBIR A GITHUB)
.env
.env.local
.env.production
server/.env
server/credentials/*.json
server/credentials/*.p12
server/credentials/*.pem
server/credentials/*.key
!server/credentials/.gitkeep
!server/credentials/google-service-account.example.json

# Datos generados en ejecución (suscripciones y clientes locales)
server/data/*.json
!server/data/.gitkeep

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
